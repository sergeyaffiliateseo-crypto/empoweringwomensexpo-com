  <style id="vap-english-footer-head-css">
    #colophon .site-top-footer-wrap { display: none !important; }
    #colophon .site-middle-footer-wrap,
    #colophon .site-middle-footer-wrap .site-footer-row-container-inner { background: #111 !important; }
    #colophon .site-middle-footer-wrap .site-container { width: 100% !important; max-width: none !important; padding: 0 !important; }
    #colophon .site-middle-footer-inner-wrap { display: block !important; padding: 0 !important; }
    #colophon .footer-html, #colophon .footer-html-inner { width: 100% !important; max-width: none !important; margin: 0 !important; }
    #colophon .footer-html-inner > p { margin: 0 !important; }

    #colophon .vap-en-footer { box-sizing: border-box; width: 100%; padding: 42px 32px 28px; background: #111; color: #fff; text-align: left; }
    #colophon .vap-en-footer__inner { width: min(100%, 1180px); margin: 0 auto; }
    #colophon .vap-en-footer__newsletter { display: grid; grid-template-columns: minmax(0, .9fr) minmax(420px, 1.1fr); gap: 32px; align-items: center; padding: 30px 32px; border-radius: 20px; background: #ff5c93; color: #111; }
    #colophon .vap-en-footer__newsletter h2 { display: block !important; width: auto !important; margin: 0 0 8px !important; padding: 0 !important; border: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; color: #111 !important; font-family: Georgia, "Times New Roman", serif; font-size: clamp(30px, 4vw, 42px) !important; font-weight: 700 !important; line-height: 1 !important; letter-spacing: -.03em; text-align: left !important; }
    #colophon .vap-en-footer__newsletter h2::before { display: none !important; content: none !important; }
    #colophon .vap-en-footer__newsletter-copy p { margin: 0 !important; color: #4a2534; font-size: 15px; line-height: 1.5; }

    #colophon .vap-en-footer__form, #colophon .vap-en-footer__form .mailpoet_form { width: 100% !important; max-width: none !important; margin: 0 !important; }
    #colophon .vap-en-footer__form > .mailpoet_form { padding: 0 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; }
    #colophon .vap-en-footer__form form.mailpoet_form,
    #colophon .vap-en-footer__form .mailpoet_form form { display: grid !important; grid-template-columns: minmax(0, 1fr) auto !important; gap: 10px !important; align-items: start !important; padding: 0 !important; margin: 0 !important; background: transparent !important; }
    #colophon .vap-en-footer__form .mailpoet_form_paragraph,
    #colophon .vap-en-footer__form .mailpoet_paragraph { margin: 0 !important; }
    #colophon .vap-en-footer__form .mailpoet_text { box-sizing: border-box; width: 100% !important; min-height: 54px; padding: 0 16px !important; border: 2px solid transparent !important; border-radius: 12px !important; background: #fff4f8 !important; color: #211b1e !important; font-size: 16px !important; }
    #colophon .vap-en-footer__form .mailpoet_text:focus { border-color: #111 !important; outline: none; box-shadow: 0 0 0 3px rgba(17,17,17,.16); }
    #colophon .vap-en-footer__form .mailpoet_submit { width: auto !important; min-height: 54px; padding: 0 22px !important; border: 2px solid #111 !important; border-radius: 12px !important; background: #111 !important; color: #ff7ca8 !important; font-size: 16px !important; font-weight: 700 !important; cursor: pointer; }
    #colophon .vap-en-footer__form .mailpoet_submit:hover { background: #fff !important; color: #111 !important; }
    #colophon .vap-en-footer__form .mailpoet_message,
    #colophon .vap-en-footer__form .mailpoet_form_loading { grid-column: 1 / -1; }
    #colophon .vap-en-footer__note { margin: 8px 0 0 !important; color: #52283a; font-size: 12px; }

    #colophon .vap-en-footer__main { display: grid; grid-template-columns: minmax(260px, 1.45fr) 1fr 1fr; gap: 48px; padding: 46px 4px 36px; text-align: left; }
    #colophon .vap-en-footer__brand { margin: 0 0 12px !important; color: #ff5c93; font-family: Georgia, "Times New Roman", serif; font-size: 28px; line-height: 1; }
    #colophon .vap-en-footer__intro { max-width: 360px; margin: 0 !important; color: #bdb4b9; font-size: 14px; line-height: 1.6; }
    #colophon .vap-en-footer__column h3 { margin: 0 0 16px !important; color: #fff; font-size: 15px; text-align: left; }
    #colophon .vap-en-footer__column p { margin: 0 !important; padding: 0 !important; }
    #colophon .vap-en-footer__column br { display: none !important; }
    #colophon .vap-en-footer__column a { display: block; width: fit-content; margin: 0 0 9px !important; color: #bdb4b9; font-size: 14px; line-height: 1.45; text-decoration: none; }
    #colophon .vap-en-footer__column a:hover, #colophon .vap-en-footer__column a:focus { color: #ff5c93; }
    #colophon .vap-en-footer__signature { padding-top: 26px; border-top: 1px solid #373237; text-align: center; }
    #colophon .vap-en-footer__signature p { margin: 5px 0 !important; color: #c8c0c4; font-size: 13px; line-height: 1.5; }
    #colophon .vap-en-footer__heart { color: #ff5c93; }

    .entry-content .vap-category-page { padding: 0 !important; background: transparent !important; }
    .entry-content .vap-category-page .vap-category-lead { max-width: 900px; margin: 0 0 12px !important; padding: 0 !important; color: #303542; font-family: inherit !important; font-size: 16px !important; font-weight: 400; line-height: 1.7; }
    .entry-content .vap-category-page .vap-category-context { max-width: 900px; margin: 0 0 38px !important; color: #59606e; font-size: 16px; line-height: 1.7; }
    .entry-content .vap-category-page h2.vap-category-heading { display: block !important; width: auto !important; margin: 48px 0 18px !important; padding: 0 0 10px !important; border: 0 !important; border-bottom: 2px solid #ff5c93 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; color: #252a36 !important; font-size: clamp(27px, 3vw, 36px) !important; font-weight: 750 !important; line-height: 1.2 !important; text-align: left !important; }
    .entry-content .vap-category-page h2.vap-category-heading--intro { margin-top: 0 !important; }
    .entry-content .vap-category-page h2.vap-category-heading::before { display: none !important; content: none !important; }
    .entry-content .vap-category-page .vaip-compare { width: 100%; max-width: none; margin-top: 0; }
    .entry-content .vap-category-quote { position: relative; margin: 34px 0 42px; padding: 28px 32px 26px; border: 0; border-left: 5px solid #ff4d93; border-radius: 0 16px 16px 0; background: #fff2f7; }
    .entry-content .vap-category-quote p { margin: 0 0 10px; color: #272b35; font-family: Georgia, "Times New Roman", serif; font-size: clamp(21px, 2.5vw, 28px); font-style: italic; line-height: 1.45; }
    .entry-content .vap-category-quote cite { color: #775866; font-size: 13px; font-style: normal; font-weight: 700; }
    .entry-content .vap-category-quote--dark { border-left-color: #ff5c93; background: #171717; }
    .entry-content .vap-category-quote--dark p { color: #fff; }
    .entry-content .vap-category-quote--dark cite { color: #d7cbd0; }
    .entry-content .vap-category-fit { gap: 18px; margin: 22px 0 38px; }
    .entry-content .vap-category-fit__item { height: 100%; padding: 24px 26px; border: 1px solid #e8dfe3; border-radius: 14px; background: #fff; }
    .entry-content .vap-category-fit__item--yes { border-top: 4px solid #ff4d93; }
    .entry-content .vap-category-fit__item--no { border-top: 4px solid #2d3038; }
    .entry-content .vap-category-fit__item h3 { margin: 0 0 14px; color: #252a36; font-size: 19px; }
    .entry-content .vap-category-fit__item ul { margin-bottom: 0; }
    .entry-content .vap-category-fit__item li { margin-bottom: 8px; }
    .entry-content .vap-category-advice { gap: 18px; margin: 26px 0 6px; }
    .entry-content .vap-category-advice__item { height: 100%; padding: 22px 24px; border: 1px solid #eadfe4; border-radius: 14px; background: #fff8fb; }
    .entry-content .vap-category-advice__item h3 { margin: 0 0 10px; color: #252a36; font-size: 18px; }
    .entry-content .vap-category-advice__item p { margin: 0; color: #4f5663; font-size: 15px; line-height: 1.65; }

    @media (max-width: 800px) {
      #colophon .vap-en-footer { padding: 26px 20px; }
      #colophon .vap-en-footer__newsletter { grid-template-columns: 1fr; gap: 22px; padding: 26px 22px; }
      #colophon .vap-en-footer__main { grid-template-columns: 1fr 1fr; gap: 34px 24px; padding-top: 38px; }
      #colophon .vap-en-footer__identity { grid-column: 1 / -1; }
    }
    @media (max-width: 520px) {
      #colophon .vap-en-footer__form form.mailpoet_form,
      #colophon .vap-en-footer__form .mailpoet_form form,
      #colophon .vap-en-footer__main { grid-template-columns: 1fr !important; }
      /* MailPoet adds a white card and field margins after this stylesheet.
         On phones, keep the email field and button directly on the pink panel. */
      #colophon .vap-en-footer__form [id^="mailpoet_form_"].mailpoet_form {
        background: transparent !important;
        border-radius: 0 !important;
      }
      #colophon .vap-en-footer__form [id^="mailpoet_form_"].mailpoet_form .mailpoet_paragraph {
        margin: 0 !important;
      }
      #colophon .vap-en-footer__identity { grid-column: auto; }
      #colophon .vap-en-footer__form .mailpoet_submit { width: 100% !important; }
      .entry-content .vap-category-advice,
      .entry-content .vap-category-fit { grid-template-columns: 1fr !important; }
      .entry-content .vap-category-quote { padding: 22px 20px; }
    }
  </style>
  <style id="wp-custom-css">
:root {
  color-scheme: light dark;
}

/* Wrapper responsive (scroll horizontal sur mobile) */
.review-summary-wrapper {
  max-width: 100%;
  overflow-x: auto;
}

/* TABLE DE BASE (LIGHT MODE) */
.review-summary {
  width: 100%;
  border-collapse: separate;
  border-spacing: 0;
  margin: 20px 0;
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 15px;
}

/* Header jaune Google */
.review-summary thead th {
  background: #FEEA3B;
  color: #1a1a1a;
  text-align: left;
  padding: 12px 16px;
  font-size: 18px;
  border-bottom: 2px solid #e0c85b;
  border-top-left-radius: 6px;
  border-top-right-radius: 6px;
}

/* Cellules */
.review-summary tbody td {
  padding: 12px 14px;
  border-bottom: 1px solid #e5e5e5;
  vertical-align: top;
}

/* Colonne de gauche (fond bleu + texte blanc) */
.review-summary tbody tr td:first-child {
  background: #1A73E8;          /* Bleu Google */
  color: #ffffff;               /* Texte blanc */
  width: 26%;
  font-weight: 600;
  border-right: 2px solid #ffffff15;
}

/* Lignes alternées pour colonne de droite uniquement */
.review-summary tbody tr:nth-child(even) td:last-child {
  background: #fafafa;
}

/* Coins bas arrondis */
.review-summary tbody tr:last-child td:first-child {
  border-bottom-left-radius: 6px;
}
.review-summary tbody tr:last-child td:last-child {
  border-bottom-right-radius: 6px;
}

/* ---- MODE SOMBRE ---- */
@media (prefers-color-scheme: dark) {
  .review-summary {
    background: #020617; /* Slate très sombre */
  }

  .review-summary thead th {
    background: #FACC15;         /* Jaune un peu plus doux en dark */
    color: #020617;
    border-bottom-color: #EAB308;
  }

  .review-summary tbody td {
    border-bottom: 1px solid #1f2937;
    color: #e5e7eb;              /* Texte clair */
  }

  .review-summary tbody tr td:first-child {
    background: #1D4ED8;         /* Bleu un peu plus profond */
    color: #EFF6FF;
    border-right: 2px solid #0b1220;
  }

  .review-summary tbody tr:nth-child(even) td:last-child {
    background: #020617;
  }

  .review-summary tbody tr:nth-child(odd) td:last-child {
    background: #020617;
  }
}

/* ---- RESPONSIVE (TEXTE UN PEU PLUS PETIT SUR MOBILE) ---- */
@media (max-width: 600px) {
  .review-summary {
    font-size: 14px;
  }
  .review-summary thead th {
    font-size: 16px;
    padding: 10px 12px;
  }
  .review-summary tbody td {
    padding: 10px 10px;
  }
}

/* Style pour le titre principal */
h1 {
  font-size: 2.5rem;      /* taille de police grande */
  font-weight: 700;       /* gras */
  color: #333333;         /* couleur — à adapter selon ton thème */
  margin-bottom: 1rem;    /* espace sous le titre */
  text-align: center;     /* centrage (optionnel) */
}

/* Style pour les sous-titres / sections */
h2 {
  font-size: 1.8rem;      /* un peu moins grand que h1 */
  font-weight: 600;
  color: #555555;         /* couleur légèrement plus douce */
  margin-top: 2rem;       /* espace avant le sous-titre */
  margin-bottom: 0.75rem; /* espace après le sous-titre */
  border-bottom: 2px solid #eaeaea; /* une ligne en dessous — optionnel */
  padding-bottom: 0.3rem; /* petit espacement pour la ligne */
}

/* =========================
   OVERRIDE — Summary en style "comparison"
   (à placer tout en bas)
   ========================= */

/* Wrapper (optionnel) */
.review-summary-wrapper{
  margin: 28px 0;
}

/* Table */
.review-summary{
  border-collapse: separate;
  border-spacing: 0;
  background: linear-gradient(180deg, #0f172a, #0b1220);
  border-radius: 20px;
  overflow: hidden;
  box-shadow: 0 18px 45px rgba(0,0,0,.35);
  color: #fff;
}

/* Header (remplace le jaune) */
.review-summary thead th{
  background: linear-gradient(90deg, #2563eb, #22d3ee);
  color: #fff;
  border-bottom: none;
  padding: 16px 20px;
  font-size: 17px;
  font-weight: 900;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
}

/* Cellules */
.review-summary tbody td{
  border-bottom: 1px solid rgba(255,255,255,.08);
  color: rgba(255,255,255,.92);
}

/* Colonne gauche (label) */
.review-summary tbody tr td:first-child{
  background: rgba(37,99,235,.12);
  color: #e5e7eb;
  font-weight: 900;
  border-right: 1px solid rgba(255,255,255,.08);
  width: 260px;
}

/* Colonne droite : on enlève tes alternances light */
.review-summary tbody tr:nth-child(even) td:last-child{
  background: transparent;
}

/* Coins bas arrondis */
.review-summary tbody tr:last-child td:first-child,
.review-summary tbody tr:last-child td:last-child{
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

/* Hover léger (optionnel mais cool) */
.review-summary tbody tr:hover{
  background: rgba(255,255,255,.02);
}

/* Strong */
.review-summary strong{
  color: #fff;
  font-weight: 900;
}

/* Responsive: en mode "cards" */
@media (max-width: 900px){
  .review-summary thead{
    display: none;
  }

  .review-summary,
  .review-summary tbody,
  .review-summary tr,
  .review-summary td{
    display: block;
    width: 100%;
  }

  .review-summary tr{
    border-top: 1px solid rgba(255,255,255,.08);
  }

  .review-summary tbody td:first-child{
    width: 100%;
    border-right: none;
    border-bottom: 1px solid rgba(255,255,255,.08);
    background: rgba(37,99,235,.18);
  }

  .review-summary tbody td:last-child{
    padding-top: 12px;
  }
}

/* ======================================================
   AI GIRLFRIEND – DESIGN SYSTEM
   Comparison table + Featured Brand CTA
   ====================================================== */

.aigf-table,
.aigf-brand {
  color: #ffffff;
}

/* ======================================================
   SHARED ELEMENTS
   ====================================================== */

.aigf-logoWrap{
  width:56px;
  height:56px;
  border-radius:16px;
  background:rgba(255,255,255,.06);
  display:flex;
  align-items:center;
  justify-content:center;
  overflow:hidden;
  box-shadow: inset 0 0 0 1px rgba(255,255,255,.08);
}

.aigf-logo{
  width:44px;
  height:44px;
  object-fit:contain;
}

/* Tag */
.aigf-tag{
  background:#2563eb;
  padding:6px 12px;
  border-radius:999px;
  font-size:12px;
  font-weight:900;
  line-height:1;
}

/* ======================================================
   SCORE BAR (IMPROVED CONTRAST)
   ====================================================== */

.aigf-bar{
  background:rgba(0,0,0,.65);
  height:14px;
  border-radius:999px;
  overflow:hidden;
  border:2px solid rgba(59,130,246,.85);
  box-shadow:
    inset 0 0 0 1px rgba(255,255,255,.08),
    0 0 0 1px rgba(34,211,238,.25);
}

.aigf-bar span{
  display:block;
  height:100%;
  background:linear-gradient(90deg,#3b82f6,#22d3ee);
  box-shadow:0 0 14px rgba(34,211,238,.25);
}

/* ======================================================
   COMPARISON TABLE (CARDS)
   ====================================================== */

.aigf-row{
  background:linear-gradient(180deg,#0f172a,#0b1220);
  border-radius:20px;
  padding:22px;
  margin-bottom:18px;
  display:grid;
  grid-template-columns:1fr 340px 260px;
  gap:22px;
  align-items:center;
  box-shadow:0 18px 45px rgba(0,0,0,.35);
}

.aigf-left{
  display:flex;
  align-items:center;
  gap:16px;
}

.aigf-topline{
  display:flex;
  flex-wrap:wrap;
  align-items:center;
  gap:12px;
}

.aigf-name{
  font-size:26px;
  font-weight:900;
  letter-spacing:-.02em;
  white-space:nowrap;
}

.aigf-reviewLink{
  display:none;
}

.aigf-mid{
  min-width:0;
}

.aigf-score{
  margin-top:10px;
  font-weight:900;
  font-size:22px;
}

.aigf-price{
  margin-top:8px;
  font-weight:800;
  font-size:18px;
  opacity:.95;
}

.aigf-cta a{
  background:#16a34a;
  color:#ffffff;
  padding:18px;
  border-radius:16px;
  display:block;
  text-align:center;
  font-weight:900;
  font-size:22px;
  text-decoration:none;
}

.aigf-cta a:hover{
  filter:brightness(1.05);
}

/* ======================================================
   FEATURED BRAND CTA
   ====================================================== */

.aigf-brand{
  margin:28px 0;
}

.aigf-brand__card{
  background:linear-gradient(180deg,#0f172a,#0b1220);
  border-radius:20px;
  padding:22px;
  display:grid;
  grid-template-columns:1fr 280px 260px;
  gap:22px;
  align-items:center;
  box-shadow:0 18px 45px rgba(0,0,0,.35);
}

.aigf-brand__left{
  display:flex;
  gap:16px;
  align-items:center;
}

.aigf-brand__meta{
  display:flex;
  flex-direction:column;
  justify-content:center;
}

.aigf-brand__highlights{
  margin:6px 0 0;
  padding:0;
  list-style:none;
  display:grid;
  gap:8px;
}

.aigf-brand__highlights li{
  position:relative;
  padding-left:18px;
  font-weight:700;
  color:rgba(255,255,255,.9);
  line-height:1.35;
}

.aigf-brand__highlights li::before{
  content:'';
  position:absolute;
  left:0;
  top:8px;
  width:8px;
  height:8px;
  border-radius:999px;
  background:linear-gradient(90deg,#3b82f6,#22d3ee);
  box-shadow:0 0 14px rgba(34,211,238,.25);
}

/* Remove review link in CTA */
.aigf-brand .aigf-reviewLink{
  display:none!important;
}

.aigf-brand__mid{
  min-width:0;
}

.aigf-brand__cta a{
  background:#16a34a;
  color:#ffffff;
  padding:18px;
  border-radius:16px;
  display:block;
  text-align:center;
  font-weight:900;
  font-size:22px;
  text-decoration:none;
}

.aigf-brand__cta a:hover{
  filter:brightness(1.05);
}

/* ======================================================
   RESPONSIVE
   ====================================================== */

@media(max-width:980px){
  .aigf-row,
  .aigf-brand__card{
    grid-template-columns:1fr;
    gap:16px;
  }

  .aigf-score{
    font-size:20px;
  }

  .aigf-cta a,
  .aigf-brand__cta a{
    font-size:20px;
  }
}

/* ======================================================
   AIGF BRAND CTA — FINAL (stable)
   ====================================================== */

/* Titre + badge sur la même ligne */
.aigf-brand .aigf-topline{
  display:flex;
  align-items:center;
  gap:12px;
  flex-wrap:wrap;
}

/* Le bloc texte (titre + bullets) */
.aigf-brand .aigf-brand__meta{
  display:flex;
  flex-direction:column;
  justify-content:flex-start;
}

/* Bullets : texte aligné avec le titre */
.aigf-brand .aigf-brand__highlights{
  list-style:none;
  margin:8px 0 0 0;
  padding:0;
}

/* On réserve de la place à gauche pour le point */
.aigf-brand .aigf-brand__highlights li{
  position:relative;
  padding-left:0;           /* texte commence sous "Candy AI" */
  margin:0 0 8px 0;
  line-height:1.35;
}

/* Le point sort à gauche (hanging bullet) */
.aigf-brand .aigf-brand__highlights li::before{
  content:'';
  position:absolute;
  left:-18px;               /* ajuste -16 / -20 si besoin */
  top:0.55em;
  width:7px;
  height:7px;
  border-radius:999px;
  background:linear-gradient(90deg,#3b82f6,#22d3ee);
  box-shadow:0 0 14px rgba(34,211,238,.25);
}
/* === Bullets alignés sous le titre (pas sous le logo) === */
.aigf-brand .aigf-brand__highlights{
  padding-left: 26px; /* 56 (logo) + 16 (gap) */
}

.aigf-brand .aigf-brand__highlights li::before{
  left: -22px; /* reste dans l'indent de la liste */
}

/* === H2 pleine largeur avec picto === */
h2 {
  display: block;
  width: 100%;
  background: #FF4D93;
  color: #ffffff;
  padding: 12px 20px 12px 48px; /* padding left augmenté pour le picto */
  border-radius: 12px;
  font-size: 1.6rem;
  font-weight: 900;
  line-height: 1.25;
  margin: 36px 0 22px;
  position: relative;
}

/* Picto avant le texte */
h2::before {
  content: "★"; /* ou ► ● ✦ */
  position: absolute;
  left: 20px;
  top: 50%;
  transform: translateY(-50%);
  font-size: 1.1rem;
  color: #ffffff;
  opacity: 0.95;
}

/* ===== Author box – HERO / DARK BACKGROUND ===== */
.entry-hero .aigf-author-compact,
.entry-header .aigf-author-compact {
  border: 1px solid rgba(255,255,255,.25);
  background: rgba(255,255,255,.08);
  backdrop-filter: blur(6px);
}

.entry-hero .aigf-author-compact *,
.entry-header .aigf-author-compact * {
  color: #fff;
}

.entry-hero .aigf-author-role,
.entry-header .aigf-author-role,
.entry-hero .aigf-author-date,
.entry-header .aigf-author-date {
  color: rgba(255,255,255,.75);
}

.entry-hero .aigf-author-photo-empty,
.entry-header .aigf-author-photo-empty {
  background: rgba(255,255,255,.25);
}

/* Hover link */
.entry-hero .aigf-author-compact a:hover,
.entry-header .aigf-author-compact a:hover {
  text-decoration: underline;
}

/* ======================================================
   OURDREAM FR — TABLEAUX ET VERDICT
   Ciblé uniquement sur la page française (ID 14)
   ====================================================== */
.page-id-14 .vaip-review-table-wrap {
  width: 100%; margin: 26px 0 32px; overflow-x: auto;
  border: 1px solid #eadfea; border-radius: 16px; background: #fff;
  box-shadow: 0 12px 32px rgba(64,25,71,.10); -webkit-overflow-scrolling: touch;
}
.page-id-14 .vaip-review-table-wrap:focus { outline: 3px solid rgba(255,77,147,.35); outline-offset: 3px; }
.page-id-14 .vaip-review-table {
  width: 100%; min-width: 680px; margin: 0; border: 0;
  border-collapse: separate; border-spacing: 0; color: #29232d;
  font-size: 15px; line-height: 1.55;
}
.page-id-14 .vaip-review-table th,
.page-id-14 .vaip-review-table td {
  padding: 15px 17px; border: 0; border-right: 1px solid #eee5ef;
  border-bottom: 1px solid #eee5ef; text-align: left; vertical-align: top;
}
.page-id-14 .vaip-review-table th:last-child,
.page-id-14 .vaip-review-table td:last-child { border-right: 0; }
.page-id-14 .vaip-review-table tbody tr:last-child td { border-bottom: 0; }
.page-id-14 .vaip-review-table thead th {
  background: linear-gradient(115deg,#7a2f72,#ff4d93); color: #fff;
  font-size: 15px; font-weight: 800; letter-spacing: .01em;
}
.page-id-14 .vaip-review-table tbody tr:nth-child(even) td { background: #fcf8fc; }
.page-id-14 .vaip-review-table tbody td:first-child { color: #63265e; font-weight: 750; background: #fff7fb; }
.page-id-14 .vaip-review-table tbody tr:nth-child(even) td:first-child { background: #f8edf6; }
.page-id-14 .vaip-review-table tbody tr:hover td { background: #fff2f8; }
.page-id-14 .vaip-pros-cons-grid {
  display: grid; grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 18px; margin: 26px 0 34px;
}
.page-id-14 .vaip-pros-cons-grid section {
  padding: 22px 22px 18px; border: 1px solid #eadfea; border-radius: 16px;
  box-shadow: 0 10px 28px rgba(64,25,71,.08);
}
.page-id-14 .vaip-pros { background: linear-gradient(180deg,#f2fff8,#fff); }
.page-id-14 .vaip-cons { background: linear-gradient(180deg,#fff7fb,#fff); }
.page-id-14 .vaip-pros-cons-grid h3 { margin: 0 0 14px; color: #42233f; font-size: 1.18rem; }
.page-id-14 .vaip-pros-cons-grid ul { margin: 0; padding-left: 1.25rem; }
.page-id-14 .vaip-pros-cons-grid li { margin-bottom: 10px; }
.page-id-14 .vaip-pros li::marker { color: #168651; }
.page-id-14 .vaip-cons li::marker { color: #d23b79; }

/* OURDREAM FR — CENTRAGE DES CAPTURES */
.page-id-14 .entry-content figure.wp-block-image {
  width: fit-content; max-width: 100%; margin-left: auto; margin-right: auto; text-align: center;
}
.page-id-14 .entry-content figure.wp-block-image img {
  display: block; max-width: 100%; height: auto; margin-left: auto; margin-right: auto;
}
.page-id-14 .entry-content figure.wp-block-image figcaption { text-align: center; }

@media (max-width: 720px) {
  .page-id-14 .vaip-review-table-wrap { margin: 20px 0 26px; border-radius: 12px; }
  .page-id-14 .vaip-review-table { min-width: 640px; font-size: 14px; }
  .page-id-14 .vaip-review-table th,
  .page-id-14 .vaip-review-table td { padding: 12px 13px; }
  .page-id-14 .vaip-pros-cons-grid { grid-template-columns: 1fr; }
}

/* ======================================================
