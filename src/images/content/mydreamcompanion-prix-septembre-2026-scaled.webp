/* ======================================================
   VAIP — TABLEAUX DE REVUE ROSES (GLOBAL)
   Limite aux anciens tableaux .review-summary et aux
   nouveaux tableaux .vaip-review-table.
   ====================================================== */

.review-summary-wrapper,
.vaip-review-table-wrap {
  width: 100%;
  max-width: 100%;
  margin: 26px 0 32px;
  overflow-x: auto;
  border: 1px solid #eadfea;
  border-radius: 16px;
  background: #ffffff;
  box-shadow: 0 12px 32px rgba(64, 25, 71, .10);
  -webkit-overflow-scrolling: touch;
}

.review-summary-wrapper:focus,
.vaip-review-table-wrap:focus {
  outline: 3px solid rgba(255, 77, 147, .35);
  outline-offset: 3px;
}

.review-summary,
.vaip-review-table {
  display: table;
  width: 100%;
  min-width: 680px;
  margin: 0;
  border: 0;
  border-radius: 0;
  border-collapse: separate;
  border-spacing: 0;
  overflow: visible;
  background: #ffffff;
  box-shadow: none;
  color: #29232d;
  font-family: "Inter", system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
  font-size: 15px;
  line-height: 1.55;
}

.review-summary thead,
.vaip-review-table thead {
  display: table-header-group;
}

.review-summary tbody,
.vaip-review-table tbody {
  display: table-row-group;
}

.review-summary tr,
.vaip-review-table tr {
  display: table-row;
  width: auto;
  border: 0;
}

.review-summary th,
.review-summary td,
.vaip-review-table th,
.vaip-review-table td {
  display: table-cell;
  width: auto;
  padding: 15px 17px;
  border: 0;
  border-right: 1px solid #eee5ef;
  border-bottom: 1px solid #eee5ef;
  color: #29232d;
  text-align: left;
  vertical-align: top;
}

.review-summary th:last-child,
.review-summary td:last-child,
.vaip-review-table th:last-child,
.vaip-review-table td:last-child {
  border-right: 0;
}

.review-summary tbody tr:last-child td,
.vaip-review-table tbody tr:last-child td {
  border-bottom: 0;
  border-bottom-left-radius: 0;
  border-bottom-right-radius: 0;
}

.review-summary thead th,
.vaip-review-table thead th {
  padding: 15px 17px;
  border-bottom: 1px solid #eee5ef;
  border-top-left-radius: 0;
  border-top-right-radius: 0;
  background: linear-gradient(115deg, #7a2f72, #ff4d93);
  color: #ffffff;
  font-size: 15px;
  font-weight: 800;
  letter-spacing: .01em;
}

.review-summary tbody tr:nth-child(odd) td,
.vaip-review-table tbody tr:nth-child(odd) td {
  background: #ffffff;
}

.review-summary tbody tr:nth-child(even) td,
.vaip-review-table tbody tr:nth-child(even) td {
  background: #fcf8fc;
}

.review-summary tbody tr td:first-child,
.vaip-review-table tbody tr td:first-child {
  width: auto;
  border-right: 1px solid #eee5ef;
  background: #fff7fb;
  color: #63265e;
  font-weight: 750;
}

.review-summary tbody tr:nth-child(even) td:first-child,
.vaip-review-table tbody tr:nth-child(even) td:first-child {
  background: #f8edf6;
}

.review-summary tbody tr:hover td,
.vaip-review-table tbody tr:hover td {
  background: #fff2f8;
}

.review-summary strong,
.vaip-review-table strong {
  color: inherit;
}

@media (max-width: 720px) {
  .review-summary-wrapper,
  .vaip-review-table-wrap {
    margin: 20px 0 26px;
    border-radius: 12px;
  }

  .review-summary,
  .vaip-review-table {
    min-width: 640px;
    font-size: 14px;
  }

  .review-summary th,
  .review-summary td,
  .vaip-review-table th,
  .vaip-review-table td {
    padding: 12px 13px;
  }
}


/* VAIP — correction de contraste du texte des tableaux */
.review-summary tbody tr td:not(:first-child),
.vaip-review-table tbody tr td:not(:first-child) {
  color: #3b3240;
}

.review-summary tbody tr td:not(:first-child) strong,
.vaip-review-table tbody tr td:not(:first-child) strong {
  color: inherit;
}

/* VAIP editorial bullets — rose discret — 2026-08-20 */
.entry-content > ul:not([class]) {
  list-style: none;
  margin: 1.15em 0 1.4em;
  padding: 0;
  display: grid;
  gap: 0.85rem;
}

.entry-content > ul:not([class]) > li {
  position: relative;
  margin: 0;
  padding-left: 2rem;
}

.entry-content > ul:not([class]) > li::before {
  content: "✓";
  position: absolute;
  left: 0;
  top: 0.12em;
  display: grid;
  place-items: center;
  width: 1.4rem;
  height: 1.4rem;
  box-sizing: border-box;
  border: 1px solid #ef9cbd;
  border-radius: 999px;
  color: #cf3976;
  background: #fff8fb;
  font-size: 0.78rem;
  font-weight: 700;
  line-height: 1;
}

@media (prefers-color-scheme: dark) {
  .entry-content > ul:not([class]) > li::before {
    border-color: #d66c98;
    color: #ff9dc3;
    background: #33252d;
  }
}

@media (max-width: 480px) {
  .entry-content > ul:not([class]) {
    gap: 0.75rem;
  }

  .entry-content > ul:not([class]) > li {
    padding-left: 1.85rem;
  }
}

/* VAIP header — anthracite premium — staging — 2026-08-20 */
#masthead,
#masthead .site-main-header-wrap,
#masthead .site-main-header-wrap .site-header-row-container-inner,
#mobile-header .site-main-header-wrap,
#mobile-header .site-main-header-wrap .site-header-row-container-inner {
  background: #17151a !important;
}

#masthead .site-main-header-wrap .site-header-row-container-inner,
#mobile-header .site-main-header-wrap .site-header-row-container-inner {
  border-bottom: 1px solid #352e35;
  box-shadow: 0 8px 24px rgba(0, 0, 0, 0.16);
}

#masthead .site-branding img,
#mobile-header .site-branding img {
  filter: invert(1) hue-rotate(180deg) saturate(1.15) brightness(1.28);
  mix-blend-mode: screen;
}

#masthead .header-navigation .header-menu-container > ul > li.menu-item,
#masthead .header-navigation .header-menu-container > ul > li.menu-item > a {
  background: transparent !important;
  border-radius: 0 !important;
}

#masthead .header-navigation .header-menu-container > ul > li.menu-item > a {
  color: #f5f2f4 !important;
  box-shadow: none;
  font-weight: 600;
}

#masthead .header-navigation .header-menu-container > ul > li.menu-item > a:hover,
#masthead .header-navigation .header-menu-container > ul > li.menu-item > a:focus-visible {
  color: #f78ab5 !important;
}

#masthead .header-navigation .header-menu-container > ul > li.current-menu-item > a,
#masthead .header-navigation .header-menu-container > ul > li.current_page_item > a {
  color: #f78ab5 !important;
  background: transparent !important;
  box-shadow: inset 0 -2px 0 #f24d8f;
}

#masthead .header-navigation .dropdown-nav-toggle,
#masthead .header-navigation .kadence-svg-iconset {
  color: inherit;
}

#masthead .header-navigation .header-menu-container ul ul.sub-menu,
#masthead .header-navigation .header-menu-container ul ul.submenu {
  background: #211e23 !important;
  border: 1px solid #3a343b;
  box-shadow: 0 18px 42px rgba(0, 0, 0, 0.38);
}

#masthead .header-navigation .header-menu-container ul ul li.menu-item,
#masthead .header-navigation .header-menu-container ul ul li.menu-item > a {
  background: transparent !important;
}

#masthead .header-navigation .header-menu-container ul ul li.menu-item > a {
  color: #f1edf0 !important;
  border-bottom-color: #352f36;
}

#masthead .header-navigation .header-menu-container ul ul li.menu-item > a:hover,
#masthead .header-navigation .header-menu-container ul ul li.menu-item > a:focus-visible,
#masthead .header-navigation .header-menu-container ul ul li.current-menu-item > a,
#masthead .header-navigation .header-menu-container ul ul li.current_page_item > a {
  color: #ff9fc4 !important;
  background: #2d272e !important;
}

#masthead .mobile-toggle-open-container .menu-toggle-open,
#masthead .search-toggle-open-container .search-toggle-open {
  color: #f5f2f4 !important;
  background: transparent !important;
}

#masthead .mobile-toggle-open-container .menu-toggle-open:hover,
#masthead .mobile-toggle-open-container .menu-toggle-open:focus-visible,
#masthead .search-toggle-open-container .search-toggle-open:hover,
#masthead .search-toggle-open-container .search-toggle-open:focus-visible {
  color: #f78ab5 !important;
}

#mobile-drawer .drawer-inner {
  color: #f5f2f4;
  background: #17151a !important;
}

#mobile-drawer .drawer-header {
  border-bottom: 1px solid #352e35;
}

#mobile-drawer .drawer-toggle {
  color: #f5f2f4 !important;
}

#mobile-drawer .mobile-navigation ul li > a {
  color: #f1edf0 !important;
  border-bottom-color: #352e35;
}

#mobile-drawer .mobile-navigation ul li > a:hover,
#mobile-drawer .mobile-navigation ul li > a:focus-visible,
#mobile-drawer .mobile-navigation ul li.current-menu-item > a,
#mobile-drawer .mobile-navigation ul li.current-menu-ancestor > a {
  color: #ff9fc4 !important;
}

#masthead a:focus-visible,
#mobile-drawer a:focus-visible,
#mobile-drawer button:focus-visible {
  outline-color: #f24d8f;
}

/* VAIP category introductions — normal content width — 2026-08-20 */
.vap-category-page > .wp-block-group__inner-container.is-layout-constrained > .vap-category-lead,
.vap-category-page > .wp-block-group__inner-container > .vap-category-lead {
  width: 100% !important;
  max-width: none !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* VAIP category page container — full entry width — 2026-08-20 */
.entry-content > .vap-category-page,
.single-content > .vap-category-page {
  width: 100% !important;
  max-width: none !important;
  margin-left: 0 !important;
  margin-right: 0 !important;
}

/* VAIP navigation — direct active branch only — 2026-08-20 */
#masthead .header-navigation .header-menu-container > ul > li.current-menu-ancestor:has(> ul > li.current-menu-item) > a,
#masthead .header-navigation .header-menu-container > ul > li.current_page_ancestor:has(> ul > li.current_page_item) > a {
  color: #f78ab5 !important;
  background: transparent !important;
  box-shadow: inset 0 -2px 0 #f24d8f;
}


/* VAIP TABLE CONTRAST FIX 2026-09-14 */
@media (prefers-color-scheme: dark) {
  .review-summary tbody tr:nth-child(odd) td:last-child {
    background: #ffffff;
    color: #3b3240;
  }

  .review-summary tbody tr:nth-child(even) td:last-child {
    background: #fcf8fc;
    color: #3b3240;
  }
}

/* VAIP global — reduced hero/content gap — production — 2026-09-25 */
.content-area {
  margin-top: 2rem;
}

@media (max-width: 767px) {
  .content-area {
    margin-top: 0;
  }
}

/* VAIP editorial title and mobile author refresh — production — 2026-09-25 */
/* Titles: compact on phones, a single unbroken line when desktop width allows. */
h1 {
  margin: 0 0 1.25rem;
  color: inherit;
  font-size: clamp(2rem, 3.1vw, 2.75rem);
  font-weight: 800;
  line-height: 1.12;
  letter-spacing: -.035em;
  text-align: inherit;
}

.entry-header .entry-title {
  max-width: none;
  margin-right: auto;
  margin-left: auto;
  text-align: center;
  text-wrap: balance;
}

@media (max-width: 767px) {
  h1 {
    margin-bottom: 1.1rem;
    font-size: clamp(1.875rem, 8.2vw, 2.25rem);
    line-height: 1.13;
  }

  .entry-header .entry-title {
    max-width: 18ch;
  }

  /* The refined author box is intentionally mobile-only. */
  .entry-header .aigf-author-compact {
    box-sizing: border-box;
    width: min(100%, 35rem);
    margin: .25rem auto 0;
    padding: 10px 13px;
    gap: 12px;
    align-items: flex-start;
    border: 1px solid rgba(255,255,255,.20);
    border-radius: 14px;
    background: rgba(255,255,255,.07);
    box-shadow: 0 12px 28px rgba(0,0,0,.16);
    text-align: left;
  }

  .entry-header .aigf-author-photo {
    width: 42px;
    height: 42px;
    border-radius: 12px;
    box-shadow: 0 0 0 1px rgba(255,255,255,.15);
  }

  .entry-header .aigf-author-compact-body {
    flex: 1 1 auto;
    min-width: 0;
  }

  .entry-header .aigf-author-compact-line1 {
    display: block;
    align-self: center;
    font-size: 1rem;
    font-weight: 800;
    line-height: 1.2;
  }

  .entry-header .aigf-author-compact-line1 a {
    color: inherit;
  }

  .entry-header .aigf-author-dot {
    display: none;
  }

  .entry-header .aigf-author-role {
    display: block;
    margin-top: 3px;
    font-size: .82rem;
    font-weight: 650;
    line-height: 1.25;
    opacity: .72;
  }

  .entry-header .aigf-author-compact-line2 {
    gap: 5px;
    margin-top: 0;
    padding-top: 6px;
    border-top: 1px solid rgba(255,255,255,.15);
    font-size: clamp(.68rem, 2.75vw, .78rem);
    font-weight: 500;
    line-height: 1.35;
    opacity: .78;
  }

  .entry-header .aigf-author-sep {
    opacity: .45;
  }

  /* Keep the short visual bridge between the author card and the first block. */
  body:has(.entry-header .aigf-author-compact) .content-area {
    margin-top: 1rem;
  }
}

/* VAIP reduced mobile first CTA gap — production — 2026-09-25 */
@media (max-width: 767px) {
  .entry-content > .aigf-brand:first-child {
    margin-top: 10px;
  }
}

/* VAIP mobile first CTA gap 10px — production — 2026-09-25 */

