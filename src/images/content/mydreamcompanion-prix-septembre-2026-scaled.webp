  .aigf-author-compact{display:flex;gap:12px;align-items:center;border:1px solid rgba(128,128,128,.22);border-radius:14px;padding:12px 14px;margin:14px 0 0}
  .aigf-author-compact-body{min-width:0;text-align:left!important}
  .aigf-author-compact-line1{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px;font-weight:800;line-height:1.2}
  .aigf-author-compact-line1 a{text-decoration:none}
  .aigf-author-role{font-weight:700;opacity:.78}
  .aigf-author-dot{opacity:.55}
  .aigf-author-compact-line2{display:flex;flex-wrap:wrap;gap:8px;margin-top:4px;opacity:.82;font-size:.92em;line-height:1.2}
  .aigf-author-source{display:flex;justify-content:flex-start;margin-top:7px;font-size:.88em;line-height:1.3;opacity:.9;text-align:left!important}
  .aigf-author-source a{display:inline-flex;align-items:center;border-left:3px solid currentColor;border-radius:0 8px 8px 0;padding:5px 9px;background:rgba(128,128,128,.10);text-decoration:none}
  .aigf-author-sep{opacity:.55}
  .aigf-author-photo{width:44px;height:44px;border-radius:12px;object-fit:cover;flex:0 0 auto}
  .aigf-author-photo-empty{display:flex;align-items:center;justify-content:center;background:rgba(128,128,128,.15);color:rgba(80,80,80,.72)}
  .aigf-author-photo-empty .dashicons{width:24px;height:24px;font-size:24px;line-height:24px}
  .aigf-author-box{display:flex;gap:14px;align-items:flex-start;border:1px solid rgba(128,128,128,.25);border-radius:14px;padding:16px;margin:22px 0}
  .aigf-author-name{font-weight:900;font-size:1.05em}
  .aigf-author-role{opacity:.8;margin-top:2px}
  .aigf-author-bio p{margin:8px 0 0}
  .aigf-author-dates{display:flex;flex-wrap:wrap;gap:10px;margin-top:10px;opacity:.85;font-size:.92em}
  @media(max-width:560px){
    .aigf-author-compact{display:grid;grid-template-columns:40px minmax(0,1fr);column-gap:10px;align-items:start}
    .aigf-author-compact-body{display:contents}
    .aigf-author-photo{grid-column:1;grid-row:1;width:40px;height:40px;border-radius:12px}
    .aigf-author-compact-line1{grid-column:2;grid-row:1}
    .aigf-author-source{grid-column:2}
    .aigf-author-compact-line2{grid-column:1/-1;display:flex;flex-wrap:nowrap;gap:5px;white-space:nowrap;font-size:clamp(.65rem,2.6vw,.82rem);margin-top:8px}
    .aigf-author-compact-line2 .aigf-author-sep{display:inline}
    .aigf-author-box{flex-direction:column}
  }
  </style><style>.aigf-breadcrumbs{margin:0 0 16px;color:rgba(255,255,255,.58);font-size:.8rem;line-height:1.4}.aigf-breadcrumbs ol{display:flex;flex-wrap:wrap;gap:7px;list-style:none;margin:0;padding:0}.aigf-breadcrumbs li{min-width:0}.aigf-breadcrumbs li+li:before{content:"/";margin-right:7px;color:rgba(255,255,255,.3)}.aigf-breadcrumbs a{color:rgba(255,255,255,.68);text-decoration:none}.aigf-breadcrumbs a:hover{color:#ff8fc7;text-decoration:underline}.aigf-breadcrumbs a:focus-visible{outline:2px solid #ff8fc7;outline-offset:3px;border-radius:2px}.aigf-breadcrumbs [aria-current="page"]{color:rgba(255,255,255,.48);overflow-wrap:anywhere}</style>  <style id="vap-category-pages-css">
    .entry-content .vap-category-page { padding: 0 !important; background: transparent !important; }
    .entry-content .vap-category-page .vap-category-lead,
    .entry-content .vap-category-page .vap-category-context { max-width: 900px; padding: 0 !important; font-family: inherit !important; font-size: 16px !important; font-weight: 400; line-height: 1.7; }
    .entry-content .vap-category-page .vap-category-lead { margin: 0 0 12px !important; color: #303542; }
    .entry-content .vap-category-page .vap-category-context { margin: 0 0 38px !important; color: #59606e; }
    .entry-content .vap-category-page h2.vap-category-heading { display: block !important; width: auto !important; margin: 48px 0 18px !important; padding: 0 0 10px !important; border: 0 !important; border-bottom: 2px solid #ff5c93 !important; border-radius: 0 !important; background: transparent !important; box-shadow: none !important; color: #252a36 !important; font-size: clamp(27px, 3vw, 36px) !important; font-weight: 750 !important; line-height: 1.2 !important; text-align: left !important; }
    .entry-content .vap-category-page h2.vap-category-heading--intro { margin-top: 0 !important; }
    .entry-content .vap-category-page h2.vap-category-heading::before { display: none !important; content: none !important; }
    .entry-content .vap-category-page .vaip-compare { width: 100%; max-width: none; margin-top: 0; }
    .entry-content .vap-category-quote { position: relative; margin: 34px 0 42px; padding: 28px 32px 26px; border: 0; border-left: 5px solid #ff4d93; border-radius: 0 16px 16px 0; background: #fff2f7; }
    .entry-content .vap-category-quote p { margin: 0 0 10px; color: #272b35; font-family: Georgia, "Times New Roman", serif; font-size: clamp(21px, 2.5vw, 28px); font-style: italic; line-height: 1.45; }
    .entry-content .vap-category-quote cite { color: #775866; font-size: 13px; font-style: normal; font-weight: 700; }
    .entry-content .vap-category-quote--dark { border-left-color: #ff5c93; background: #171717; }
    .entry-content .vap-category-quote--dark p { color: #fff; }
    .entry-content .vap-category-quote--dark cite { color: #d7cbd0; }
    .entry-content .vap-category-fit { gap: 18px; margin: 22px 0 38px; }
    .entry-content .vap-category-fit__item { height: 100%; padding: 24px 26px; border: 1px solid #e8dfe3; border-radius: 14px; background: #fff; }
    .entry-content .vap-category-fit__item--yes { border-top: 4px solid #ff4d93; }
    .entry-content .vap-category-fit__item--no { border-top: 4px solid #2d3038; }
    .entry-content .vap-category-fit__item h3 { margin: 0 0 14px; color: #252a36; font-size: 19px; }
    .entry-content .vap-category-fit__item ul { margin-bottom: 0; }
    .entry-content .vap-category-fit__item li { margin-bottom: 8px; }
    @media (max-width: 520px) {
      .entry-content .vap-category-fit { grid-template-columns: 1fr !important; }
      .entry-content .vap-category-quote { padding: 22px 20px; }
    }
  </style>
  <link rel="icon" href="https://www.virtualaipartner.com/wp-content/uploads/2026/03/favicon-VAIP-150x150.png" sizes="32x32" />
