}
.vaip-review-table-wrap:focus { outline: 3px solid rgba(255,77,147,.35); outline-offset: 3px; }
.vaip-review-table {
  width: 100%; min-width: 680px; margin: 0; border: 0;
  border-collapse: separate; border-spacing: 0; color: #29232d;
  font-size: 15px; line-height: 1.55;
}
.vaip-review-table th,
.vaip-review-table td {
