/* VAIP: gold halo for the first CTA on the English homepage ranking. */
body.home .aigf-table[data-lang="en"] > .aigf-row:first-child > .aigf-cta > a {
  position: relative;
}

body.home .aigf-table[data-lang="en"] > .aigf-row:first-child > .aigf-cta > a::after {
  content: '';
  box-sizing: border-box;
  position: absolute;
  inset: -4px;
  border-radius: calc(16px + 4px);
  pointer-events: none;
  border: 1px solid rgb(246 196 83 / 42%);
  box-shadow: 0 0 9px rgb(246 196 83 / 19%);
}

@media (prefers-reduced-motion: no-preference) and (forced-colors: none) {
  @supports (offset-path: inset(-4px round 20px)) {
    body.home .aigf-table[data-lang="en"] > .aigf-row:first-child > .aigf-cta > a::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 20px;
      height: 3px;
      border-radius: 50%;
      pointer-events: none;
      background: linear-gradient(90deg, transparent, #f6c453 33%, #fff9db 58%, #f6c453 76%, transparent);
      filter: drop-shadow(0 0 3px #f6c453);
      offset-path: inset(-3.5px round 19.5px);
      offset-anchor: center;
      animation: vaip-first-ranked-halo-orbit 2.4s linear infinite;
      z-index: 1;
    }
  }
}

body.home .aigf-table[data-lang="en"] > .aigf-row:first-child > .aigf-cta > a:focus-visible {
  outline: 2px solid currentColor;
  outline-offset: 7px;
}

@keyframes vaip-first-ranked-halo-orbit {
  from { offset-distance: 0%; }
  to { offset-distance: 100%; }
}

