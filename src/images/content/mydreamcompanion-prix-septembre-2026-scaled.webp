  <script>
  (function(){
    function slugFromHref(href){
      try{
        var u = new URL(href, window.location.origin);
        var m = u.pathname.match(/^\/go\/([^\/]+)\/?$/);
        return m ? m[1] : null;
      }catch(e){ return null; }
    }

    function postClick(payload){
      var params = new URLSearchParams();
      params.append('action', 'vaip_click');
      params.append('slug', payload.slug);
      params.append('el', payload.el);
      params.append('src', payload.src);
      params.append('ref', payload.ref);

      try {
        fetch('https://www.virtualaipartner.com/wp-admin/admin-ajax.php', {
          method: 'POST',
          headers: {'Content-Type':'application/x-www-form-urlencoded;charset=UTF-8'},
          body: params.toString(),
          keepalive: true,
          credentials: 'same-origin'
        }).catch(function(){});
      } catch(e) {}
    }

    document.addEventListener('click', function(e){
      var a = e.target && e.target.closest ? e.target.closest('a') : null;
      if(!a || !a.href) return;

      var slug = slugFromHref(a.getAttribute('href') || a.href);
      if(!slug) return;

      var el = 'text';

// 1) si el= est dans l'URL, on respecte
try {
  var u = new URL(a.href, window.location.origin);
  var urlEl = u.searchParams.get('el');
  if (urlEl) el = urlEl;
} catch(e) {}

// 2) sinon, on "reconnaît" un CTA via classes/attributs (shortcode => button)
if (el === 'text') {
  var cls = ((a.getAttribute('class') || '') + ' ' + (a.parentElement ? (a.parentElement.getAttribute('class') || '') : '')).toLowerCase();
  var role = (a.getAttribute('role') || '').toLowerCase();

  if (
    cls.indexOf('btn') !== -1 ||
    cls.indexOf('button') !== -1 ||
    cls.indexOf('cta') !== -1 ||
    cls.indexOf('wp-block-button') !== -1 ||
    role === 'button'
  ) {
    el = 'button';
  }
}


      postClick({
        slug: slug,
        el: el,
        src: window.location.pathname,
        ref: document.referrer || ''
      });
    }, true);
  })();
  </script>
  </body>
